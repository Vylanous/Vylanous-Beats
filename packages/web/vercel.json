{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "buildCommand": "cd ../.. && bun install && cd packages/web && bun run build",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && bun install"
}