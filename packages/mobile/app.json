{
  "expo": {
    "name": "Vylanous Beats",
    "slug": "vylanous-beats",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vylanousbeats",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/c5ce894e-f856-4c49-8318-1a0be3fe9bcb"
    },
    "ios": {
      "bundleIdentifier": "com.vylanousbeats.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:www.vylanous.com",
        "applinks:vylanous.com",
        "applinks:www.vylanous.com",
        "applinks:vylanous.com"
      ]
    },
    "android": {
      "package": "com.vylanousbeats.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0A11"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.vylanous.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.vylanous.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0A11"
    },
    "plugins": [
      "expo-router",
      "expo-iap",
      "expo-updates"
    ],
    "extra": {
      "apiUrl": "https://www.vylanous.com",
      "router": {},
      "eas": {
        "projectId": "c5ce894e-f856-4c49-8318-1a0be3fe9bcb"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "owner": "vylanouss-team"
  }
}
