{
  "expo": {
    "name": "Vylanous Beats",
    "slug": "vylanous-beats",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vylanousbeats",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/c5ce894e-f856-4c49-8318-1a0be3fe9bcb"
    },
    "ios": {
      "bundleIdentifier": "com.vylanousbeats.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "associatedDomains": ["applinks:www.vylanous.com", "applinks:vylanous.com"]
    },
    "android": {
      "package": "com.vylanousbeats.app",
      "versionCode": 3,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0C"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.vylanous.com",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-iap",
      "expo-updates",
      "expo-audio",
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0C"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "apiUrl": "https://www.vylanous.com",
      "router": {},
      "eas": {
        "projectId": "c5ce894e-f856-4c49-8318-1a0be3fe9bcb"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "owner": "vylanouss-team"
  }
}
