{
  "name": "sandbox-app-template",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd packages/web && bunx vite",
    "dev:desktop": "cd packages/desktop && bunx vite",
    "dev:mobile": "cd packages/mobile && bunx expo start",
    "start": "pm2 delete web-app 2>/dev/null || true; pm2 start ecosystem.config.cjs --update-env",
    "build": "turbo build",
    "build:web": "cd packages/web && bunx vite build",
    "audit:reachable": "bun run scripts/security-audit.mjs",
    "validate:releases": "bun run .runable/validate-releases.ts",
    "lint": "bun run validate:releases && oxlint . --ignore-pattern 'packages/desktop/dist-electron/**' --deny-warnings --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --deny-warnings --no-error-on-unmatched-pattern",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "db:studio": "turbo db:studio",
    "kill:port": "lsof -t -i :${PORT:-4200} | xargs kill -9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "~3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@libsql/client": "^0.17.4",
    "cloudflare": "^5.2.0",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "form-data": "4.0.6",
    "kysely": "0.28.17",
    "pm2": "^7.0.3",
    "postcss": "8.5.26",
    "shell-quote": "1.10.0",
    "tar": "7.5.22",
    "undici": "7.29.0",
    "vite": "7.3.6",
    "vite-plugin-electron": "1.1.1",
    "vite-plugin-electron-renderer": "1.0.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@tursodatabase/api": "^1.9.2",
    "@types/bun": "1.3.14",
    "@types/semver": "^7.8.0",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "semver": "^7.8.5",
    "turbo": "2.9.18",
    "typescript": "5.9.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@libsql/isomorphic-ws>ws": "8.21.3",
    "@react-native/dev-middleware>ws": "7.5.13",
    "@runablehq/website-runtime>nanoid": "5.1.16",
    "@xmldom/xmldom": "0.8.15",
    "app-builder-lib": "26.15.3",
    "brace-expansion@<2": "1.1.18",
    "brace-expansion@>=2 <3": "2.1.4",
    "brace-expansion@>=4 <5": "4.0.1",
    "brace-expansion@>=5 <6": "5.0.9",
    "builder-util-runtime": "9.7.0",
    "electron-builder-squirrel-windows": "26.15.3",
    "form-data": "4.0.6",
    "ip-address": "10.5.0",
    "js-yaml@4": "4.3.1",
    "jsdom>undici": "7.29.0",
    "minimatch@3>brace-expansion": "1.1.18",
    "minimatch@9>brace-expansion": "2.1.4",
    "nanoid@<4": "3.3.18",
    "nanoid@>=4 <6": "5.1.16",
    "postcss": "8.5.26",
    "shell-quote": "1.10.0",
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "undici@>=7 <8": "7.29.0",
    "ws@>=7 <8": "7.5.13",
    "ws@>=8 <9": "8.21.3"
  },
  "packageManager": "bun@1.3.14"
}
