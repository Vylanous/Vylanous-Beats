# Environment
NODE_ENV=development
WEBSITE_URL=http://localhost:3000
APP_URL=http://localhost:3000
APPLICATION_ID=

# Admin auth (REQUIRED — auth fails closed if these are unset)
# BETTER_AUTH_SECRET must be a long random string, distinct from ADMIN_PASSWORD.
BETTER_AUTH_SECRET=
ADMIN_PASSWORD=

# Database (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Payments (Stripe)
STRIPE_SECRET_KEY=
# REQUIRED for server-side payment fulfillment. In Stripe, create/configure the
# endpoint https://www.vylanous.com/api/webhooks/stripe and copy this endpoint's
# signing secret (whsec_...). Select checkout.session.completed and
# checkout.session.async_payment_succeeded. Set the value only in the production
# environment; never commit or paste webhook secrets into source control or chat.
STRIPE_WEBHOOK_SECRET=

# Delivery email (Resend) — REQUIRED to send buyer download emails.
RESEND_API_KEY=
EMAIL_FROM="Vylanous Beats <no-reply@your-domain.com>"
# Resend webhook signing secret — REQUIRED for inbound email and delivery-status events.
RESEND_WEBHOOK_SECRET=

# Object storage (Cloudflare R2) — REQUIRED for admin uploads, audio previews, artwork and downloads.
# The S3_* equivalents (S3_ENDPOINT, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_BUCKET)
# are also accepted; set one set or the other, not a mix.
# Browser uploads use presigned PUT URLs. Configure a matching R2 bucket CORS policy that allows
# the live website origin to PUT with the Content-Type header; see docs/deployment-object-storage.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=
