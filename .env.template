# ── Environment ────────────────────────────────────────────────────
NODE_ENV=development
# Public base URL of the site. Used for Stripe success/cancel redirects
# and for building download links in delivery emails.
APP_URL=http://localhost:4200
WEBSITE_URL=http://localhost:4200
# Fallback used when APP_URL is unset.
PUBLIC_URL=http://localhost:4200
# Port the Bun server listens on.
PORT=4200
APPLICATION_ID=

# ── Database (Turso / libSQL) ──────────────────────────────────────
# Local file DB: file:./local.db   Remote: libsql://<db>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ── Admin auth (REQUIRED — the API refuses to boot without these) ──
# Signing secret for admin session tokens. Minimum 16 chars.
# Generate: openssl rand -hex 32
ADMIN_TOKEN_SECRET=
# Preferred: sha256 hex digest of the admin password (64 hex chars).
# Generate: printf '%s' 'your-password' | sha256sum
ADMIN_PASSWORD_HASH=
# Fallback for local dev only, used when ADMIN_PASSWORD_HASH is unset.
# Minimum 10 chars. Prefer ADMIN_PASSWORD_HASH in production.
ADMIN_PASSWORD=
# Legacy alias for ADMIN_TOKEN_SECRET (still read by the Vercel handler).
BETTER_AUTH_SECRET=

# ── CORS ───────────────────────────────────────────────────────────
# Comma-separated allow-list of browser origins permitted to send
# credentialed requests. Empty = same-origin only.
ALLOWED_ORIGINS=http://localhost:4200

# ── Stripe ─────────────────────────────────────────────────────────
# Checkout is disabled (409) when STRIPE_SECRET_KEY is unset.
STRIPE_SECRET_KEY=
# Required to accept POST /api/stripe/webhook. Get it from
# `stripe listen` locally or the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET=

# ── Object storage (S3 / Cloudflare R2) ────────────────────────────
# Without S3_BUCKET, stored keys are returned unsigned and paid
# deliverables cannot be served.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Custom endpoint for non-AWS providers. For R2 either set this to
# https://<account-id>.r2.cloudflarestorage.com or set R2_ACCOUNT_ID.
S3_ENDPOINT=
R2_ACCOUNT_ID=

# ── Gateway Configuration ──────────────────────────────────────────
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# ── Payments and tracking ──────────────────────────────────────────
AUTUMN_SECRET_KEY=
